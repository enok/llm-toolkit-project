flowchart TB
    RI["Prompt, then AGENTS.md<br/>rules, INTENTS.md router"]
    C["Ledger<br/>TASKS_TABLE.md<br/>CONTEXT_STATE.md"]
    O["Thin root<br/>orchestrator"]
    L1["light<br/>→ haiku"]
    L2["standard<br/>→ sonnet"]
    L3["deep<br/>→ opus"]
    V["Validator ≠ producer<br/>max 5 refinements"]
    X["Root (frontier)<br/>reduces, writes"]
    G(["External writes need<br/>exact user instruction"])

    RI ==> O
    C <-.-> O
    O ==> L1
    O ==> L2
    O ==> L3
    L1 ==> V
    L2 ==> V
    L3 ==> V
    V ==> X
    X ==> G

