flowchart TB
    U(["User prompt"])
    RI["AGENTS.md rules<br/>INTENTS.md router<br/>one primary capability"]
    O["Thin root orchestrator<br/>split, assign, dispatch"]
    C["Ledger, root-written<br/>TASKS_TABLE.md<br/>CONTEXT_STATE.md<br/>state, facts, resume"]
    M["model-selector tiers<br/>each task, then wave<br/>dispatch carries task,<br/>criteria, constraints,<br/>ledger path"]
    T(["Trivial request:<br/>answered inline"])
    L1["light → haiku<br/>retrieve, scan,<br/>run tests"]
    L2["standard → sonnet<br/>draft, review,<br/>reduce evidence"]
    L3["deep → opus<br/>architecture,<br/>security"]
    V["Validator ≠ producer<br/>four-block return<br/>fail → refine, max 5 iterations"]
    X["Root = frontier tier<br/>(the session model)<br/>reduces, judges,<br/>owns all writes"]
    G{"Exact user<br/>instruction?"}
    E(["Yes: external write<br/>PR, email, chat"])
    N(["No: draft NOT POSTED<br/>ask for approval"])
    R["Retrospective<br/>run record"]
    P["Promote:<br/>learning,<br/>checklist,<br/>guard, rule"]

    U ==> RI
    RI ==> O
    O <-.-> C
    O ==> M
    O -.-> T
    M ==> L1
    M ==> L2
    M ==> L3
    L1 <==> V
    L2 <==> V
    L3 <==> V
    V ==> X
    X ==> G
    G --> E
    G --> N
    X --> R
    R --> P
    P -.-> RI

