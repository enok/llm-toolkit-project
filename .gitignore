# Anthropic source-available skills (import locally; do NOT redistribute)
# Import via: scripts/import-anthropic-skills.sh
skills/pdf/
skills/docx/
skills/pptx/
skills/xlsx/

# Agent-side skill junctions (created by setup scripts, NOT committed content).
# The CANONICAL skills live in skills/; agent dirs link to it at setup time.
# Without these rules, git on Windows would traverse the junction and duplicate content.
.agents/skills/*
.claude/agents/*
.claude/skills/*
.codex/agents/*
.codex/config.toml
.codex/skills/*
.cursor/agents/*
.cursor/rules/*
.cursor/skills/*
.cursor/workflows/*
.windsurf/rules/*
.windsurf/skills/*
.windsurf/workflows/*

# Temporary helper scripts
scripts/_create-junctions.cmd

# Generated consumer handoff notes must not be committed to the toolkit.
docs/llm/session_handoff.md

# Generated exports are intentionally tracked only when refreshed for this toolkit.
# Source of truth: AGENTS.md, rules/, workflows/, skills/, and tool-subagents/.
